# =====================================================================
# PainelPed — variáveis de ambiente (modelo; copie e preencha)
# =====================================================================
#
# DE ONDE A CONFIGURAÇÃO VEM (a primeira que tiver a chave vence):
#   1. Variáveis do próprio processo — em produção, as definidas no serviço
#      NSSM (`nssm set <servico> AppEnvironmentExtra CHAVE=valor ...`).
#      Serviços disparados pela API herdam as variáveis da API.
#   2. O arquivo apontado por PAINEL_ENV_FILE (caminho absoluto). Recomendado
#      em produção: UM arquivo fora das pastas do código, usado por todos os
#      processos (`AppEnvironmentExtra PAINEL_ENV_FILE=D:\PainelPed\painel.env`).
#   3. O .env padrão do processo: OL_API/.env (API) ou o .env ao lado do
#      script/.exe do serviço (OL_Services/.env). Prático em desenvolvimento.
#
# O ol_core NÃO tem .env próprio: OL_CORE/ol_core/.env deixou de ser lido.
# Ver OL_CORE/ol_core/core/config.py.
# =====================================================================

# --- Ambiente --------------------------------------------------------
# Producao  -> envia arquivos ao FTP e usa as pastas reais das indústrias.
# Homologacao (padrão quando ausente) -> NÃO envia ao FTP; o importa_pedidos
#   redireciona as pastas para OL_LOCAL e exige MySQL local.
PAINEL_ENV=Homologacao
# O CNPJ do distribuidor agora é configurado na tela de Parametrização
# (parâmetro `cnpj_distribuidor`). Esta variável só é usada uma vez: semeia o
# parâmetro na primeira subida da API em que ele ainda não existe.
CNPJ_DISTRIBUIDOR=

# --- MySQL (banco operacional do painel) -----------------------------
MYSQL_HOST=
MYSQL_PORTA=3306
MYSQL_BANCO=
MYSQL_USUARIO=
MYSQL_SENHA=
# Timeouts em segundos / tentativas de abrir a conexão (1 = sem retry)
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
MYSQL_CONEXAO_TENTATIVAS=2
# Só a API: espera por conexão livre no pool
MYSQL_POOL_TIMEOUT=10

# --- SQL Server do ERP (somente consulta) ----------------------------
ERP_SERVIDOR=
ERP_BANCO=
ERP_USUARIO=
ERP_SENHA=
ERP_CONNECT_TIMEOUT=10
ERP_QUERY_TIMEOUT=60
ERP_POOL_TIMEOUT=10

# --- FTP da indústria ------------------------------------------------
FTP_SERVER=
FTP_USER=
FTP_PASSWORD=

# --- Logs ------------------------------------------------------------
# Pasta única de logs para todos os processos (cada um grava <processo>.log:
# api.log, importa_pedidos.log, retornos.log...). Sem LOG_DIR, cada processo
# usa a pasta `logs` ao lado do próprio ponto de entrada.
LOG_DIR=
# Rotação: tamanho máximo de cada arquivo (MB) e quantos antigos manter
LOG_MAX_MB=10
LOG_BACKUPS=10

# --- Só a API --------------------------------------------------------
CORS_ORIGINS=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Chave dos endpoints serviço-a-serviço (heartbeat). Vazia = bloqueados.
SERVICOS_API_KEY=
# Pasta do OL_Services (download de arquivos, execução manual de serviços).
# Sem valor: ../OL_Services relativo ao OL_API.
OL_SERVICES_PATH=
# Bootstrap do banco na subida (desligar se o schema é gerenciado por fora)
DB_AUTO_CRIAR=true
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# --- Só homologação ----------------------------------------------------
# Quantos pedidos simulados o importa_pedidos gera por indústria a cada execução
HOMOLOG_QTD_PEDIDOS=1

